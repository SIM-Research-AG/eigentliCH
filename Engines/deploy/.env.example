# sim-tech / eigentliCH on Docker: settings and secrets.
#
#   cp .env.example .env && chmod 600 .env
#
# Then replace EVERY value marked CHANGE_ME. This file holds placeholders only; .env holds the
# real values and is never committed or copied into the image (docker/simtech.Dockerfile.dockerignore
# excludes it). A quick way to make a password:  openssl rand -base64 24 | tr -d '/+='
# Avoid spaces, quotes and the characters @ : / in passwords (some engines also accept URLs).

# ---- compose ------------------------------------------------------------------------------------
# Tag given to the locally built image simtech/simtech.
IMAGE_TAG=local
TZ=Europe/Zurich

# ---- PostgreSQL administrator (the db container) ------------------------------------------------
# The superuser the server is created with. The provisioning, the backup and the restore use it;
# no engine does. Keep the name `myuser`: objects in the owner's dump that are owned by the
# administrator then keep a valid owner after the restore.
POSTGRES_ADMIN_USER=myuser
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# ---- one login role per engine (store/provision.py: SIMTECH_<ENGINE>_PASSWORD) -----------------
# The provisioning creates each role with this password; the engine connects with the same value
# (docker/run.sh hands each engine its own one, and no other). Changing one later: README.md,
# "Changing a password".
SIMTECH_DATAFEED_PASSWORD=CHANGE_ME
SIMTECH_HONI_PASSWORD=CHANGE_ME
SIMTECH_MACROFIELD_PASSWORD=CHANGE_ME
SIMTECH_AGGREGATION_PASSWORD=CHANGE_ME
SIMTECH_MRS_PASSWORD=CHANGE_ME
SIMTECH_FMRE_PASSWORD=CHANGE_ME
SIMTECH_PCP_PASSWORD=CHANGE_ME
SIMTECH_CYCLE_PASSWORD=CHANGE_ME
SIMTECH_LBS_PASSWORD=CHANGE_ME
SIMTECH_LBSIM_PASSWORD=CHANGE_ME
SIMTECH_REPORT_PASSWORD=CHANGE_ME
SIMTECH_CHATBOT_PASSWORD=CHANGE_ME
SIMTECH_EIGENTLICH_PASSWORD=CHANGE_ME
# The cockpit's curator login (reads and writes schema eigentlich only).
SIMTECH_CURATOR_PASSWORD=CHANGE_ME
# The read-only catalogue login (Notion metadata export; nothing in the containers uses it).
SIMTECH_CATALOGUE_PASSWORD=CHANGE_ME

# ---- MiniMind (spark7) access for report and chatbot --------------------------------------------
# The Cloudflare Access service token of the spark7 model server. The owner gives you the values.
SPARK7_CLIENT_ID=CHANGE_ME
SPARK7_CLIENT_SECRET=CHANGE_ME

# ---- Cloudflare Tunnel ------------------------------------------------------------------------
# The token of the tunnel created in Cloudflare Zero Trust (Networks > Tunnels). cloudflared runs
# inside the simtech container and starts only when this is set; leave it empty to run without
# the tunnel (e.g. a test). README.md, "Cloudflare Tunnel and Access".
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
# cloudflared release built into the image (from Cloudflare's own image). Change and rebuild.
CLOUDFLARED_VERSION=2026.9.3

# ---- cockpit --------------------------------------------------------------------------------------
# development: everything, including the engines' test benches and every write through the proxy.
# cio: the CIO workspace and system status only; the proxy refuses writes except cio.writable.
COCKPIT_MODE=development
# Optional: the app's public address (the tunnel hostname), so that the cockpit's System page
# links it. Empty: the System page links an engine only when the cockpit is opened on 127.0.0.1
# (e.g. through compose.debug.yaml), never the 127.0.0.1 addresses through the tunnel.
# The cockpit reads COCKPIT_ENGINE_<KEY>_PUBLIC_URL for every engine in its roster (KEY in
# capitals, e.g. LBSIM), but the engines have no public hostname here (README.md, "Cloudflare
# Tunnel and Access"); such a variable would also have to be added to compose.yaml.
COCKPIT_ENGINE_EIGENTLICH_PUBLIC_URL=

# ---- datafeed -------------------------------------------------------------------------------------
# Empty switches the admin ingest route off (403). Set a long random value only when needed.
DATAFEED_ADMIN_TOKEN=

# ---- resources of the simtech container -----------------------------------------------------------
# lbsim plan workers: each solve keeps one core busy. At least 1. README.md, "Sizing".
LBSIM_WORKERS=3
# CPU cores and memory the whole simtech container may use (compose `cpus` and `mem_limit`).
# Rule of thumb: cores = LBSIM_WORKERS + 3, memory = 2 GB + 2 GB per worker.
SIMTECH_CPUS=6
SIMTECH_MEMORY=10g

# ---- backup (runs in the db container) -------------------------------------------------------------
# Daily pg_dump of simtech into the `backups` volume at BACKUP_AT (local time, TZ above).
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14
