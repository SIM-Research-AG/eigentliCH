# andersCH Master Model, example environment. Copy to .env and adjust.
#
# Nothing here carries a secret. Real credentials belong in a secret store, not in a file next to the code,
# and none of the engines needs one yet.

# Where the producers publish their contracts. Defaults resolve to sibling projects, so an ordinary checkout
# needs neither of these set. Override to point a run at a fixture set.
ANDERSCH_REGIME_DIR=../Macro_Model/output/regime
ANDERSCH_RETURNSET_DIR=../Fund_Map/artifacts

# The market scope and horizon a run defaults to. A ReturnSet is keyed on both, because a per-state return is
# not re-scaled across horizons. See architecture/DESIGN_snapshot_to_mandate.md section 5.2.
ANDERSCH_SCOPE=Global
ANDERSCH_HORIZON_YEARS=1.0

# Refuse to proceed on anything less reliable than this. `published` is strictest; `derived` permits computed
# inputs. `synthetic` is never accepted for a regulated decision regardless of what is set here: that rule
# lives in the contract layer, not in configuration.
ANDERSCH_MIN_RELIABILITY=derived
